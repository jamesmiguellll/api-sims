generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ApprovalRequests {
  ApprovalRequestId Int       @id(map: "PK_ApprovalRequests") @default(autoincrement())
  EntityType        String
  EntityId          Int
  DocumentNumber    String
  Amount            Decimal   @db.Decimal(18, 4)
  Status            String
  Reason            String
  RequestedBy       String
  RequestedAt       DateTime  @db.Timestamptz(6)
  ApproverId        String?
  ApproverName      String?
  ActionAt          DateTime? @db.Timestamptz(6)
  Comments          String?

  @@index([EntityType, EntityId], map: "IX_ApprovalRequests_Entity")
  @@index([RequestedAt], map: "IX_ApprovalRequests_RequestedAt")
  @@index([Status], map: "IX_ApprovalRequests_Status")
}

model AuditLogs {
  LogId      Int      @id(map: "PK_AuditLogs") @default(autoincrement())
  EntityName String
  EntityId   String
  FieldName  String
  OldValue   String
  NewValue   String
  Action     String
  Timestamp  DateTime @db.Timestamptz(6)
  UserId     String
  UserName   String   @default("")
}

model BatchConsumptions {
  BatchConsumptionId Int               @id(map: "PK_BatchConsumptions") @default(autoincrement())
  BatchId            Int
  ItemId             Int
  RequiredQuantity   Decimal           @db.Decimal(18, 3)
  SourceSupplierId   Int?
  LotId              Int?
  QuantityUsed       Decimal           @default(0.0) @db.Decimal(18, 3)
  UnitCost           Decimal           @default(0.0) @db.Decimal(18, 4)
  UomId              Int?
  InventoryLots      InventoryLots?    @relation(fields: [LotId], references: [LotId], onDelete: Restrict, onUpdate: NoAction, map: "FK_BatchConsumptions_InventoryLots_LotId")
  Items              Items             @relation(fields: [ItemId], references: [ItemId], onDelete: Cascade, onUpdate: NoAction, map: "FK_BatchConsumptions_Items_ItemId")
  ProductionBatches  ProductionBatches @relation(fields: [BatchId], references: [BatchId], onDelete: Cascade, onUpdate: NoAction, map: "FK_BatchConsumptions_ProductionBatches_BatchId")
  Suppliers          Suppliers?        @relation(fields: [SourceSupplierId], references: [SupplierId], onDelete: Cascade, onUpdate: NoAction, map: "FK_BatchConsumptions_Suppliers_SourceSupplierId")
  UnitOfMeasures     UnitOfMeasures?   @relation(fields: [UomId], references: [UomId], onDelete: Restrict, onUpdate: NoAction, map: "FK_BatchConsumptions_UnitOfMeasures_UomId")

  @@index([BatchId], map: "IX_BatchConsumptions_BatchId")
  @@index([ItemId], map: "IX_BatchConsumptions_ItemId")
  @@index([LotId], map: "IX_BatchConsumptions_LotId")
  @@index([SourceSupplierId], map: "IX_BatchConsumptions_SourceSupplierId")
  @@index([UomId], map: "IX_BatchConsumptions_UomId")
}

model BranchRequestItems {
  BranchRequestItemId Int              @id(map: "PK_BranchRequestItems") @default(autoincrement())
  BranchRequestId     Int
  ProductId           Int
  RequestedQuantity   Decimal          @db.Decimal(18, 3)
  ApprovedQuantity    Decimal          @db.Decimal(18, 3)
  DispatchedQuantity  Decimal          @db.Decimal(18, 3)
  ReceivedQuantity    Decimal          @db.Decimal(18, 3)
  Notes               String?
  BranchRequests      BranchRequests   @relation(fields: [BranchRequestId], references: [BranchRequestId], onDelete: Cascade, onUpdate: NoAction, map: "FK_BranchRequestItems_BranchRequests_BranchRequestId")
  FinishedProducts    FinishedProducts @relation(fields: [ProductId], references: [ProductId], onUpdate: NoAction, map: "FK_BranchRequestItems_FinishedProducts_ProductId")

  @@index([BranchRequestId], map: "IX_BranchRequestItems_BranchRequestId")
  @@index([ProductId], map: "IX_BranchRequestItems_ProductId")
}

model BranchRequests {
  BranchRequestId    Int                  @id(map: "PK_BranchRequests") @default(autoincrement())
  RequestNumber      String               @unique(map: "IX_BranchRequests_RequestNumber")
  BranchId           Int
  RequestDate        DateTime             @db.Timestamptz(6)
  RequiredDate       DateTime?            @db.Timestamptz(6)
  Status             String
  RequestedBy        String
  ApprovedBy         String?
  Notes              String?
  BranchRequestItems BranchRequestItems[]
  Locations          Locations            @relation(fields: [BranchId], references: [LocationId], onUpdate: NoAction, map: "FK_BranchRequests_Locations_BranchId")
  StockTransfers     StockTransfers[]

  @@index([BranchId], map: "IX_BranchRequests_BranchId")
}

model BranchReturnItems {
  BranchReturnItemId Int              @id(map: "PK_BranchReturnItems") @default(autoincrement())
  BranchReturnId     Int
  ProductId          Int
  LotId              Int?
  ReturnedQuantity   Decimal          @db.Decimal(18, 3)
  DefectCondition    String?
  Notes              String?
  BranchReturns      BranchReturns    @relation(fields: [BranchReturnId], references: [BranchReturnId], onDelete: Cascade, onUpdate: NoAction, map: "FK_BranchReturnItems_BranchReturns_BranchReturnId")
  FinishedProducts   FinishedProducts @relation(fields: [ProductId], references: [ProductId], onUpdate: NoAction, map: "FK_BranchReturnItems_FinishedProducts_ProductId")
  InventoryLots      InventoryLots?   @relation(fields: [LotId], references: [LotId], onDelete: Restrict, onUpdate: NoAction, map: "FK_BranchReturnItems_InventoryLots_LotId")

  @@index([BranchReturnId], map: "IX_BranchReturnItems_BranchReturnId")
  @@index([LotId], map: "IX_BranchReturnItems_LotId")
  @@index([ProductId], map: "IX_BranchReturnItems_ProductId")
}

model BranchReturns {
  BranchReturnId    Int                 @id(map: "PK_BranchReturns") @default(autoincrement())
  ReturnNumber      String              @unique(map: "IX_BranchReturns_ReturnNumber")
  BranchId          Int
  ReturnDate        DateTime            @db.Timestamptz(6)
  Reason            String
  Status            String
  ReturnedBy        String
  AuthorizedBy      String?
  Notes             String?
  BranchReturnItems BranchReturnItems[]
  Locations         Locations           @relation(fields: [BranchId], references: [LocationId], onUpdate: NoAction, map: "FK_BranchReturns_Locations_BranchId")

  @@index([BranchId], map: "IX_BranchReturns_BranchId")
}

model Categories {
  CategoryId   Int     @id(map: "PK_Categories") @default(autoincrement())
  CategoryName String
  Description  String
  Items        Items[]
}

model CycleCountItems {
  CycleCountItemId Int            @id(map: "PK_CycleCountItems") @default(autoincrement())
  CycleCountId     Int
  ItemId           Int
  LotId            Int?
  SystemQuantity   Decimal        @db.Decimal(18, 3)
  CountedQuantity  Decimal        @db.Decimal(18, 3)
  UnitCost         Decimal        @db.Decimal(18, 4)
  Reason           String?
  Notes            String?
  CycleCounts      CycleCounts    @relation(fields: [CycleCountId], references: [CycleCountId], onDelete: Cascade, onUpdate: NoAction, map: "FK_CycleCountItems_CycleCounts_CycleCountId")
  InventoryLots    InventoryLots? @relation(fields: [LotId], references: [LotId], onDelete: Restrict, onUpdate: NoAction, map: "FK_CycleCountItems_InventoryLots_LotId")
  Items            Items          @relation(fields: [ItemId], references: [ItemId], onUpdate: NoAction, map: "FK_CycleCountItems_Items_ItemId")

  @@index([CycleCountId], map: "IX_CycleCountItems_CycleCountId")
  @@index([ItemId], map: "IX_CycleCountItems_ItemId")
  @@index([LotId], map: "IX_CycleCountItems_LotId")
}

model CycleCounts {
  CycleCountId       Int               @id(map: "PK_CycleCounts") @default(autoincrement())
  CountNumber        String            @unique(map: "IX_CycleCounts_CountNumber")
  LocationId         Int
  CountDate          DateTime          @db.Timestamptz(6)
  ReconciledDate     DateTime?         @db.Timestamptz(6)
  Status             String
  CountedBy          String
  ReconciledBy       String?
  Notes              String?
  TotalSystemValue   Decimal           @db.Decimal(18, 4)
  TotalCountedValue  Decimal           @db.Decimal(18, 4)
  TotalVarianceValue Decimal           @db.Decimal(18, 4)
  CycleCountItems    CycleCountItems[]
  Locations          Locations         @relation(fields: [LocationId], references: [LocationId], onUpdate: NoAction, map: "FK_CycleCounts_Locations_LocationId")

  @@index([LocationId], map: "IX_CycleCounts_LocationId")
}

model Deliveries {
  DeliveryId          Int             @id(map: "PK_Deliveries") @default(autoincrement())
  DeliveryNumber      String          @unique(map: "IX_Deliveries_DeliveryNumber")
  PoId                Int
  SupplierId          Int
  ReceivingLocationId Int
  Status              String
  ScheduledDate       DateTime        @db.Timestamptz(6)
  ExpectedArrivalDate DateTime?       @db.Timestamptz(6)
  DispatchedDate      DateTime?       @db.Timestamptz(6)
  ActualArrivalDate   DateTime?       @db.Timestamptz(6)
  TrackingNumber      String?
  Carrier             String?
  DriverName          String?
  VehiclePlateNumber  String?
  DeliveryNoteNumber  String?
  ArrivalCondition    String?
  ArrivalNotes        String?
  Notes               String?
  AttachmentUrl       String?
  CreatedBy           String
  DispatchedBy        String?
  ReceivedBy          String?
  CreatedAt           DateTime        @db.Timestamptz(6)
  ArrivalAttachment   String?
  DispatchAttachment  String?
  PaymentType         String?
  ScheduledAttachment String?
  Locations           Locations       @relation(fields: [ReceivingLocationId], references: [LocationId], onUpdate: NoAction, map: "FK_Deliveries_Locations_ReceivingLocationId")
  PurchaseOrders      PurchaseOrders  @relation(fields: [PoId], references: [PoId], onUpdate: NoAction, map: "FK_Deliveries_PurchaseOrders_PoId")
  Suppliers           Suppliers       @relation(fields: [SupplierId], references: [SupplierId], onUpdate: NoAction, map: "FK_Deliveries_Suppliers_SupplierId")
  DeliveryItems       DeliveryItems[]
  Discrepancies       Discrepancies[]
  GoodsReceipts       GoodsReceipts[]

  @@index([PoId], map: "IX_Deliveries_PoId")
  @@index([ReceivingLocationId], map: "IX_Deliveries_ReceivingLocationId")
  @@index([Status], map: "IX_Deliveries_Status")
  @@index([SupplierId], map: "IX_Deliveries_SupplierId")
}

model DeliveryItems {
  DeliveryItemId     Int                 @id(map: "PK_DeliveryItems") @default(autoincrement())
  DeliveryId         Int
  PoItemId           Int
  ItemId             Int
  DeclaredQuantity   Decimal             @db.Decimal(18, 3)
  PurchaseUomId      Int
  Deliveries         Deliveries          @relation(fields: [DeliveryId], references: [DeliveryId], onDelete: Cascade, onUpdate: NoAction, map: "FK_DeliveryItems_Deliveries_DeliveryId")
  Items              Items               @relation(fields: [ItemId], references: [ItemId], onUpdate: NoAction, map: "FK_DeliveryItems_Items_ItemId")
  PurchaseOrderItems PurchaseOrderItems  @relation(fields: [PoItemId], references: [PoItemId], onUpdate: NoAction, map: "FK_DeliveryItems_PurchaseOrderItems_PoItemId")
  UnitOfMeasures     UnitOfMeasures      @relation(fields: [PurchaseUomId], references: [UomId], onUpdate: NoAction, map: "FK_DeliveryItems_UnitOfMeasures_PurchaseUomId")
  GoodsReceiptItems  GoodsReceiptItems[]

  @@index([DeliveryId], map: "IX_DeliveryItems_DeliveryId")
  @@index([ItemId], map: "IX_DeliveryItems_ItemId")
  @@index([PoItemId], map: "IX_DeliveryItems_PoItemId")
  @@index([PurchaseUomId], map: "IX_DeliveryItems_PurchaseUomId")
}

model Discrepancies {
  DiscrepancyId         Int                    @id(map: "PK_Discrepancies") @default(autoincrement())
  DiscrepancyNumber     String                 @unique(map: "IX_Discrepancies_DiscrepancyNumber")
  DiscrepancyType       String
  GrnId                 Int
  GrnNumber             String
  PoId                  Int
  PoNumber              String
  DeliveryId            Int?
  DeliveryNumber        String?
  ItemId                Int
  OrderedQuantity       Decimal                @db.Decimal(18, 3)
  PreviouslyReceivedQty Decimal                @db.Decimal(18, 3)
  CurrentReceivedQty    Decimal                @db.Decimal(18, 3)
  DiscrepancyQuantity   Decimal                @db.Decimal(18, 3)
  Status                String
  ResolutionType        String?
  ResolutionNotes       String?
  LossReportId          Int?                   @unique(map: "IX_Discrepancies_LossReportId")
  RtvId                 Int?
  ResolvedBy            String?
  ResolvedAt            DateTime?              @db.Timestamptz(6)
  CreatedAt             DateTime               @db.Timestamptz(6)
  NcrId                 Int?
  Deliveries            Deliveries?            @relation(fields: [DeliveryId], references: [DeliveryId], onUpdate: NoAction, map: "FK_Discrepancies_Deliveries_DeliveryId")
  GoodsReceipts         GoodsReceipts          @relation(fields: [GrnId], references: [GrnId], onDelete: Cascade, onUpdate: NoAction, map: "FK_Discrepancies_GoodsReceipts_GrnId")
  Items                 Items                  @relation(fields: [ItemId], references: [ItemId], onUpdate: NoAction, map: "FK_Discrepancies_Items_ItemId")
  LossReports           LossReports?           @relation(fields: [LossReportId], references: [LossReportId], onUpdate: NoAction, map: "FK_Discrepancies_LossReports_LossReportId")
  NonConformanceReports NonConformanceReports? @relation(fields: [NcrId], references: [NcrId], onUpdate: NoAction, map: "FK_Discrepancies_NonConformanceReports_NcrId")
  PurchaseOrders        PurchaseOrders         @relation(fields: [PoId], references: [PoId], onUpdate: NoAction, map: "FK_Discrepancies_PurchaseOrders_PoId")
  ReturnToVendors       ReturnToVendors?       @relation(fields: [RtvId], references: [RtvId], onUpdate: NoAction, map: "FK_Discrepancies_ReturnToVendors_RtvId")

  @@index([DeliveryId], map: "IX_Discrepancies_DeliveryId")
  @@index([GrnId], map: "IX_Discrepancies_GrnId")
  @@index([ItemId], map: "IX_Discrepancies_ItemId")
  @@index([NcrId], map: "IX_Discrepancies_NcrId")
  @@index([PoId], map: "IX_Discrepancies_PoId")
  @@index([RtvId], map: "IX_Discrepancies_RtvId")
}

model DisposalRecordItems {
  DisposalItemId   Int             @id(map: "PK_DisposalRecordItems") @default(autoincrement())
  DisposalId       Int
  LotId            Int
  ItemId           Int
  QuantityDisposed Decimal         @db.Decimal(18, 3)
  UnitCost         Decimal         @db.Decimal(18, 4)
  Notes            String?
  DisposalRecords  DisposalRecords @relation(fields: [DisposalId], references: [DisposalId], onDelete: Cascade, onUpdate: NoAction, map: "FK_DisposalRecordItems_DisposalRecords_DisposalId")
  InventoryLots    InventoryLots   @relation(fields: [LotId], references: [LotId], onUpdate: NoAction, map: "FK_DisposalRecordItems_InventoryLots_LotId")
  Items            Items           @relation(fields: [ItemId], references: [ItemId], onUpdate: NoAction, map: "FK_DisposalRecordItems_Items_ItemId")

  @@index([DisposalId], map: "IX_DisposalRecordItems_DisposalId")
  @@index([ItemId], map: "IX_DisposalRecordItems_ItemId")
  @@index([LotId], map: "IX_DisposalRecordItems_LotId")
}

model DisposalRecords {
  DisposalId          Int                   @id(map: "PK_DisposalRecords") @default(autoincrement())
  DisposalNumber      String                @unique(map: "IX_DisposalRecords_DisposalNumber")
  DisposalDate        DateTime              @db.Timestamptz(6)
  Reason              String
  TotalCost           Decimal               @db.Decimal(18, 4)
  AuthorizedBy        String
  WitnessName         String?
  Notes               String?
  DisposalRecordItems DisposalRecordItems[]
}

model DocumentSequences {
  DocumentSequenceId Int    @id(map: "PK_DocumentSequences") @default(autoincrement())
  DocType            String
  Year               Int
  LastNumber         Int

  @@unique([DocType, Year], map: "IX_DocumentSequences_DocType_Year")
}

model Drivers {
  DriverId    Int           @id(map: "PK_Drivers") @default(autoincrement())
  DriverName  String
  Number      String
  Inventories Inventories[]
}

model FinishedProducts {
  ProductId          Int                  @id(map: "PK_FinishedProducts") @default(autoincrement())
  ItemId             Int
  SellingPrice       Decimal              @db.Decimal
  Sku                String
  Variant            String               @default("")
  ImageUrl           String?
  BranchRequestItems BranchRequestItems[]
  BranchReturnItems  BranchReturnItems[]
  Items              Items                @relation(fields: [ItemId], references: [ItemId], onDelete: Cascade, onUpdate: NoAction, map: "FK_FinishedProducts_Items_ItemId")
  ProductionBatches  ProductionBatches[]
  Recipes            Recipes[]
  StockTransfers     StockTransfers[]
  ProductionRequests ProductionRequests[]

  @@index([ItemId], map: "IX_FinishedProducts_ItemId")
}

model GoodsReceiptItems {
  GrnItemId                  Int                   @id(map: "PK_GoodsReceiptItems") @default(autoincrement())
  GrnId                      Int
  PoItemId                   Int
  ItemId                     Int
  OrderedQuantity            Decimal               @db.Decimal(18, 3)
  DeliveredQuantity          Decimal               @db.Decimal(18, 3)
  PurchaseUomId              Int
  LotId                      Int?
  SupplierLotCode            String?
  ManufactureDate            DateTime?             @db.Date
  ExpiryDate                 DateTime?             @db.Date
  DeclaredQuantity           Decimal?              @db.Decimal(18, 3)
  DeliveryItemId             Int?
  Notes                      String?
  PreviouslyReceivedQuantity Decimal               @default(0.0) @db.Decimal(18, 3)
  VarianceQuantity           Decimal               @default(0.0) @db.Decimal(18, 3)
  VarianceType               String?
  DeliveryItems              DeliveryItems?        @relation(fields: [DeliveryItemId], references: [DeliveryItemId], onUpdate: NoAction, map: "FK_GoodsReceiptItems_DeliveryItems_DeliveryItemId")
  GoodsReceipts              GoodsReceipts         @relation(fields: [GrnId], references: [GrnId], onDelete: Cascade, onUpdate: NoAction, map: "FK_GoodsReceiptItems_GoodsReceipts_GrnId")
  InventoryLots              InventoryLots?        @relation(fields: [LotId], references: [LotId], onDelete: Restrict, onUpdate: NoAction, map: "FK_GoodsReceiptItems_InventoryLots_LotId")
  Items                      Items                 @relation(fields: [ItemId], references: [ItemId], onUpdate: NoAction, map: "FK_GoodsReceiptItems_Items_ItemId")
  PurchaseOrderItems         PurchaseOrderItems    @relation(fields: [PoItemId], references: [PoItemId], onUpdate: NoAction, map: "FK_GoodsReceiptItems_PurchaseOrderItems_PoItemId")
  UnitOfMeasures             UnitOfMeasures        @relation(fields: [PurchaseUomId], references: [UomId], onUpdate: NoAction, map: "FK_GoodsReceiptItems_UnitOfMeasures_PurchaseUomId")
  PutAwayTransactions        PutAwayTransactions[]
  StockInLines               StockInLines[]

  @@index([DeliveryItemId], map: "IX_GoodsReceiptItems_DeliveryItemId")
  @@index([GrnId], map: "IX_GoodsReceiptItems_GrnId")
  @@index([ItemId], map: "IX_GoodsReceiptItems_ItemId")
  @@index([LotId], map: "IX_GoodsReceiptItems_LotId")
  @@index([PoItemId], map: "IX_GoodsReceiptItems_PoItemId")
  @@index([PurchaseUomId], map: "IX_GoodsReceiptItems_PurchaseUomId")
}

model GoodsReceipts {
  GrnId                 Int                   @id(map: "PK_GoodsReceipts") @default(autoincrement())
  GrnNumber             String                @unique(map: "IX_GoodsReceipts_GrnNumber")
  PoId                  Int
  SupplierId            Int
  ReceivingLocationId   Int
  ReceivedDate          DateTime              @db.Timestamptz(6)
  DeliveryNoteNumber    String
  Carrier               String?
  ReceivedBy            String
  Status                String
  Notes                 String?
  DeliveryId            Int?
  CreatedAt             DateTime              @default(dbgenerated("'-infinity'::timestamp with time zone")) @db.Timestamptz(6)
  CreatedBy             String                @default("")
  PostedAt              DateTime?             @db.Timestamptz(6)
  PostedBy              String?
  ReceivingBay          String?
  SupplierDrNumber      String?
  SupplierInvoiceNumber String?
  RejectedAt            DateTime?             @db.Timestamptz(6)
  RejectedBy            String?
  RejectionReason       String?
  Discrepancies         Discrepancies[]
  GoodsReceiptItems     GoodsReceiptItems[]
  Deliveries            Deliveries?           @relation(fields: [DeliveryId], references: [DeliveryId], onUpdate: NoAction, map: "FK_GoodsReceipts_Deliveries_DeliveryId")
  Locations             Locations             @relation(fields: [ReceivingLocationId], references: [LocationId], onUpdate: NoAction, map: "FK_GoodsReceipts_Locations_ReceivingLocationId")
  PurchaseOrders        PurchaseOrders        @relation(fields: [PoId], references: [PoId], onUpdate: NoAction, map: "FK_GoodsReceipts_PurchaseOrders_PoId")
  Suppliers             Suppliers             @relation(fields: [SupplierId], references: [SupplierId], onUpdate: NoAction, map: "FK_GoodsReceipts_Suppliers_SupplierId")
  LossReports           LossReports[]
  PutAwayTransactions   PutAwayTransactions[]
  StockIns              StockIns[]

  @@index([DeliveryId], map: "IX_GoodsReceipts_DeliveryId")
  @@index([PoId], map: "IX_GoodsReceipts_PoId")
  @@index([ReceivingLocationId], map: "IX_GoodsReceipts_ReceivingLocationId")
  @@index([SupplierId], map: "IX_GoodsReceipts_SupplierId")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model Inventories {
  InventoryId  Int       @id(map: "PK_Inventories") @default(autoincrement())
  DriverId     Int?
  ItemId       Int
  LocationId   Int
  CurrentStock Decimal   @db.Decimal(18, 3)
  Drivers      Drivers?  @relation(fields: [DriverId], references: [DriverId], onDelete: NoAction, onUpdate: NoAction, map: "FK_Inventories_Drivers_DriverId")
  Items        Items     @relation(fields: [ItemId], references: [ItemId], onDelete: Cascade, onUpdate: NoAction, map: "FK_Inventories_Items_ItemId")
  Locations    Locations @relation(fields: [LocationId], references: [LocationId], onDelete: Cascade, onUpdate: NoAction, map: "FK_Inventories_Locations_LocationId")

  @@unique([ItemId, LocationId], map: "IX_Inventories_ItemId_LocationId")
  @@index([DriverId], map: "IX_Inventories_DriverId")
  @@index([LocationId], map: "IX_Inventories_LocationId")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model InventoryLots {
  LotId                  Int                      @id(map: "PK_InventoryLots") @default(autoincrement())
  LotCode                String
  ItemId                 Int
  LocationId             Int
  SourceType             String
  SupplierId             Int?
  SupplierLotNo          String?
  GrnLineId              Int?
  ProductionOrderId      Int?
  ReceivedDate           DateTime                 @db.Timestamptz(6)
  ManufactureDate        DateTime?                @db.Date
  ExpiryDate             DateTime?                @db.Date
  IsExpiryEstimated      Boolean
  QuantityReceived       Decimal                  @db.Decimal(18, 3)
  QuantityRemaining      Decimal                  @db.Decimal(18, 3)
  ReservedQuantity       Decimal                  @default(0.0) @db.Decimal(18, 3)
  UomId                  Int
  UnitCost               Decimal                  @db.Decimal(18, 6)
  Status                 String
  HoldReason             String?
  IsOpeningBalance       Boolean
  BatchConsumptions      BatchConsumptions[]
  BranchReturnItems      BranchReturnItems[]
  CycleCountItems        CycleCountItems[]
  DisposalRecordItems    DisposalRecordItems[]
  GoodsReceiptItems      GoodsReceiptItems[]
  Items                  Items                    @relation(fields: [ItemId], references: [ItemId], onUpdate: NoAction, map: "FK_InventoryLots_Items_ItemId")
  Locations              Locations                @relation(fields: [LocationId], references: [LocationId], onUpdate: NoAction, map: "FK_InventoryLots_Locations_LocationId")
  Suppliers              Suppliers?               @relation(fields: [SupplierId], references: [SupplierId], onDelete: Restrict, onUpdate: NoAction, map: "FK_InventoryLots_Suppliers_SupplierId")
  UnitOfMeasures         UnitOfMeasures           @relation(fields: [UomId], references: [UomId], onUpdate: NoAction, map: "FK_InventoryLots_UnitOfMeasures_UomId")
  LossReports            LossReports[]
  NonConformanceReports  NonConformanceReports[]
  ProductionBatches      ProductionBatches[]
  PutAwayTransactions    PutAwayTransactions[]
  QualityInspectionItems QualityInspectionItems[]
  ReturnToVendors        ReturnToVendors[]
  StockInLines           StockInLines[]
  StockLedgers           StockLedgers[]
  ProductionReqLotReservations ProductionReqLotReservations[]
  MaterialIssuanceScans        MaterialIssuanceScans[]

  @@unique([LotCode, LocationId], map: "IX_InventoryLots_LotCode_LocationId")
  @@index([ExpiryDate], map: "IX_InventoryLots_ExpiryDate")
  @@index([ItemId, LocationId, Status], map: "IX_InventoryLots_ItemLocationStatus")
  @@index([LocationId], map: "IX_InventoryLots_LocationId")
  @@index([SupplierId], map: "IX_InventoryLots_SupplierId")
  @@index([UomId], map: "IX_InventoryLots_UomId")
}

model InventoryMovementLogs {
  MovementId     Int       @id(map: "PK_InventoryMovementLogs") @default(autoincrement())
  ItemId         Int
  LocationId     Int
  ChangeQuantity Decimal   @db.Decimal(18, 3)
  ActionType     String
  ReferenceId    String
